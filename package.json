{
  "name": "chipboard-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @chipboard/database db:generate",
    "db:migrate": "pnpm --filter @chipboard/database db:migrate",
    "db:push": "pnpm --filter @chipboard/database db:push",
    "db:check": "pnpm --filter @chipboard/database db:check",
    "db:tables": "pnpm --filter @chipboard/database db:tables",
    "migration:audit": "node apps/chipboard/scripts/audit-classic-mysql.js",
    "migration:import-foundation": "node apps/chipboard/scripts/import-foundation-to-postgres.js",
    "migration:import-sales": "node apps/chipboard/scripts/import-sales-to-postgres.js",
    "migration:dedupe-sales": "node apps/chipboard/scripts/dedupe-postgres-sales.js",
    "migration:verify": "node apps/chipboard/scripts/verify-postgres-migration.js"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
